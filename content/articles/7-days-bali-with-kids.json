        {
          "_type": "span",
          "_key": "k4",
          "marks": [],
          "text": "Length: 7 days. Route: Sanur → Ubud → Nusa Dua. Best for: families with young children and anyone who wants a slow pace. Pace: relaxed. Best time to go: April to October. Start and end point: Denpasar (DPS)."
        }
      ]
    },
    {
