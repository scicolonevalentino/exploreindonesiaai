      "children": [
        {
          "_key": "kms125",
          "_type": "span",
          "marks": [],
          "text": "Day 6: The day you do not plan"
        }
      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "kmb129",
      "_type": "block",
      "children": [
        {
          "_key": "kms127",
          "_type": "span",
          "marks": ["strong"],
          "text": "Morning. "
        },
        {
          "_key": "kms128",
          "_type": "span",
          "marks": [],
          "text": "Snorkel from the beach. Sleep late. This is the day the honeymoon actually feels like one."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
