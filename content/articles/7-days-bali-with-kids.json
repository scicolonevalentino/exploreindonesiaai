          "marks": [],
          "text": "."
        }
      ]
    },
    {
      "_type": "block",
      "_key": "k2m",
      "style": "h2",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "k2n",
          "marks": [],
          "text": "Day 7: Slow morning and departure"
        }
      ]
    },
    {
      "_type": "block",
      "_key": "k2p",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_type": "span",
          "_key": "k2o",
          "marks": [],
          "text": "Keep the last morning simple — a final swim, breakfast by the beach and easy packing. Nusa Dua is only about 15–20 minutes from the airport, so you do not need an early, stressful start. Build in a comfortable buffer for traffic and the family check-in, and fly home relaxed rather than rushed."
        }
      ]
    },
    {
