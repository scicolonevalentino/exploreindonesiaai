      "children": [
        {
          "_key": "kms122",
          "_type": "span",
          "marks": ["strong"],
          "text": "Travel note: "
        },
        {
          "_key": "kms123",
          "_type": "span",
          "marks": [],
          "text": "Check what is actually included before booking an island stay. Some run full board because there is genuinely nowhere else to eat, and that is a feature rather than a catch."
        }
      ],
