      "children": [
        {
          "_type": "span",
          "_key": "k2h",
          "marks": [],
          "text": "In the late afternoon, continue to Nusa Dua, Bali's calmest resort area, with gentle surf, manicured beaches and big family resorts. "
        },
        {
          "_type": "span",
          "_key": "k2j",
          "marks": [
            "k2i"
          ],
          "text": "Search Nusa Dua family resorts on Booking.com"
